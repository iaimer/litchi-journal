      "html": "<input class=\"ds-input\" value=\"记录这一刻…\" aria-label=\"记录内容\">",
      "css": ".ds-input{min-height:48px;padding:12px 16px;border:1px solid #E8DCC9;border-radius:12px;background:#FFF7ED;color:#5A4A36;font:400 16px/1.5 system-ui,-apple-system,sans-serif;outline:none;transition:border-color 180ms cubic-bezier(.215,.61,.355,1)}.ds-input:focus{border-color:#A26B59}.ds-input::placeholder{color:#A48B7E}"
    },
