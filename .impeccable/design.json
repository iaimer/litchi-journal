      "css": ".ds-chip{min-height:32px;padding:6px 10px;border:1px solid rgba(255,107,107,.59);border-radius:9999px;background:rgba(255,107,107,.18);color:#5A4A36;font:600 12px/1.3 system-ui,-apple-system,sans-serif}.ds-chip:focus-visible{outline:2px solid #A26B59;outline-offset:2px}"
