  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "用于保存、确认和主要前进动作。",
      "html": "<button class=\"ds-btn-primary\">保存</button>",
      "css": ".ds-btn-primary{min-height:48px;padding:12px 24px;border:0;border-radius:12px;background:#A26B59;color:#FFF7ED;font:600 16px/1.35 system-ui,-apple-system,sans-serif;transition:filter 180ms cubic-bezier(.215,.61,.355,1),transform 180ms cubic-bezier(.215,.61,.355,1)}.ds-btn-primary:hover{filter:brightness(.96)}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:2px solid #5A4A36;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
