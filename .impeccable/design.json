      "css": ".ds-card{padding:16px;border:1px solid #E8DCC9;border-radius:12px;background:#FFF7ED;color:#5A4A36;font:400 14px/1.6 system-ui,-apple-system,sans-serif}.ds-card strong{display:block;margin-bottom:8px;font-size:16px;font-weight:600}.ds-card p{margin:0}"
    },
